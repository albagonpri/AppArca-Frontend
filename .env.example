VITE_API_URL=http://localhost:3000

# Clave de API para CARTO Voyager (recomendado para diseño moderno estilo Google Maps)
# Regístrate en https://carto.com para obtener una clave gratuita (hasta 5M peticiones/mes)
VITE_CARTO_API_KEY=

# Clave de API alternativa para MapTiler Streets (https://cloud.maptiler.com)
VITE_MAPTILER_API_KEY=

# Si no se define ninguna de las anteriores, la aplicación utiliza OpenStreetMap estándar automáticamente
